# Netlify Site configuration (Vite variables are public in the browser bundle)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com
# Must be a publicly reachable HTTPS MediaMTX WebRTC reader URL.
# Do not set this to localhost in production.
VITE_MEDIAMTX_WEBRTC_URL=https://your-video-host.example.com/mystream/
